{
  "name": "pivot-ui",
  "version": "1.0.0",
  "private": true,
  "description": "A local React component library for building 3D editor interfaces.",
  "scripts": {
    "lint": "pretty-quick --staged",
    "dev": "pnpm --filter \"@pivot-ui/editor\" dev",
    "dev:gui": "pnpm --filter \"@pivot-ui/gui\" dev",
    "dev:demo": "pnpm --filter @pivot-ui/demo dev",
    "clean": "pnpm -r run clean && rimraf .cache node_modules/.cache node_modules/.vite node_modules/.vite-temp",
    "clear": "rimraf node_modules packages/*/node_modules app/node_modules",
    "typecheck": "pnpm -r --if-present typecheck",
    "build:storybook": "pnpm --filter @pivot-ui/editor build-storybook && pnpm --filter @pivot-ui/gui build-storybook",
    "verify:quick": "pnpm exec prettier --check . && pnpm typecheck",
    "verify": "pnpm run verify:quick && pnpm build:demo && pnpm build:storybook",
    "build:demo": "pnpm --filter @pivot-ui/demo build",
    "analyze:demo": "pnpm --filter @pivot-ui/demo analyze"
  },
  "keywords": [
    "ui",
    "editor",
    "tool",
    "react",
    "3d",
    "inspector"
  ],
  "author": "Mrkou47",
  "license": "MIT",
  "packageManager": "pnpm@12.14.0",
  "devDependencies": {
    "@radix-ui/colors": "^3.0.0",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "pretty-quick": "^4.2.2",
    "rimraf": "^6.1.3",
    "rollup-plugin-visualizer": "^7.1.1",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "prettier": {
    "bracketSameLine": true,
    "semi": false,
    "trailingComma": "es5",
    "singleQuote": true,
    "tabWidth": 2,
    "printWidth": 120
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm run lint",
    "pre-push": "pnpm run verify:quick"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  }
}
