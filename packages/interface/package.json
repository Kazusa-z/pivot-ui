{
  "name": "@pivot-ui/react",
  "version": "0.1.0",
  "private": true,
  "description": "Composable React controls, templates, and property interfaces for editor applications.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./contracts": {
      "types": "./src/contracts/index.ts",
      "import": "./src/contracts/index.ts",
      "default": "./src/contracts/index.ts"
    },
    "./values": {
      "types": "./src/values/index.ts",
      "import": "./src/values/index.ts",
      "default": "./src/values/index.ts"
    },
    "./panda.css": "./panda.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "storybook dev -p 6009",
    "predev": "panda codegen",
    "storybook": "storybook dev -p 6009",
    "prestorybook": "panda codegen",
    "build-storybook": "storybook build",
    "prebuild-storybook": "panda codegen",
    "panda": "panda codegen",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.stories.json && tsc -p tsconfig.tooling.json && tsc -p tsconfig.pure.json",
    "pretypecheck": "panda codegen",
    "clean": "rimraf styled-system storybook-static .cache node_modules/.cache node_modules/.vite node_modules/.vite-temp"
  },
  "devDependencies": {
    "@pandacss/dev": "2.2.0",
    "@storybook/addon-docs": "^10.6.3",
    "@storybook/addon-links": "^10.6.3",
    "@storybook/react": "^10.6.3",
    "@storybook/react-vite": "^10.6.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rimraf": "^6.1.3",
    "storybook": "^10.6.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "peerDependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
