{
  "name": "@pivot-ui/react",
  "version": "0.1.0",
  "private": true,
  "description": "Composable React controls, templates, and property interfaces for editor applications.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./contracts": {
      "types": "./src/contracts/index.ts",
      "import": "./src/contracts/index.ts",
      "default": "./src/contracts/index.ts"
    },
    "./values": {
      "types": "./src/values/index.ts",
      "import": "./src/values/index.ts",
      "default": "./src/values/index.ts"
    },
    "./theme": {
      "types": "./src/foundation/theme/index.ts",
      "import": "./src/foundation/theme/index.ts",
      "default": "./src/foundation/theme/index.ts"
    },
    "./panda.css": "./panda.css",
    "./styling/css": {
      "types": "./styled-system/css/index.d.ts",
      "import": "./styled-system/css/index.js",
      "default": "./styled-system/css/index.js"
    },
    "./styling/jsx": {
      "types": "./styled-system/jsx/index.d.ts",
      "import": "./styled-system/jsx/index.js",
      "default": "./styled-system/jsx/index.js"
    },
    "./styling/tokens": {
      "types": "./styled-system/tokens/index.d.ts",
      "import": "./styled-system/tokens/index.js",
      "default": "./styled-system/tokens/index.js"
    },
    "./styling/types": "./styled-system/types/index.d.ts"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "storybook dev -p 6009",
    "predev": "panda codegen",
    "storybook": "storybook dev -p 6009",
    "prestorybook": "panda codegen",
    "build-storybook": "storybook build",
    "prebuild-storybook": "panda codegen",
    "panda": "panda codegen",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.stories.json && tsc -p tsconfig.tooling.json && tsc -p tsconfig.pure.json",
    "pretypecheck": "panda codegen",
    "clean": "rimraf styled-system storybook-static .cache node_modules/.cache node_modules/.vite node_modules/.vite-temp"
  },
  "devDependencies": {
    "@pandacss/dev": "2.2.0",
    "@storybook/addon-docs": "^10.6.3",
    "@storybook/addon-links": "^10.6.3",
    "@storybook/react": "^10.6.3",
    "@storybook/react-vite": "^10.6.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rimraf": "^6.1.3",
    "storybook": "^10.6.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "peerDependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.5.0",
    "@tabler/icons-react": "^3.49.0",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-use-controllable-state": "^1.3.0",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@radix-ui/react-hover-card": "^1.2.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-menubar": "^1.2.1",
    "react-hot-toast": "^2.6.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "@radix-ui/react-select": "^2.4.1"
  }
}
