{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node", "react", "react-dom", "vite/client"],
    "allowJs": true,
    "checkJs": true
  },
  "include": [
    "panda.config.ts",
    "postcss.config.cjs",
    ".storybook/**/*.ts",
    ".storybook/**/*.tsx",
    "../../storybook/**/*.ts",
    "../../storybook/**/*.tsx"
  ],
  "exclude": ["node_modules", "storybook-static"]
}
