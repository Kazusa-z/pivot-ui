{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "src/**/*.stories.ts",
    "src/**/*.stories.tsx",
    "stories/**/*.ts",
    "stories/**/*.tsx",
    "../../storybook/**/*.ts",
    "../../storybook/**/*.tsx"
  ],
  "exclude": ["node_modules", "storybook-static"]
}
