{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "checkJs": true,
    "types": ["node", "react", "react-dom", "vite/client"]
  },
  "include": [
    "panda.config.ts",
    "postcss.config.cjs",
    ".storybook/**/*.ts",
    ".storybook/**/*.tsx",
    "../../storybook/**/*.ts",
    "../../storybook/**/*.tsx"
  ],
  "exclude": ["node_modules", "storybook-static"]
}
