{
  "name": "@pivot-ui/editor",
  "version": "1.2.0",
  "private": true,
  "description": "React components for building 3D editor interfaces.",
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./panda.css": "./panda.css"
  },
  "sideEffects": false,
  "scripts": {
    "dev": "storybook dev -p 6007",
    "predev": "pnpm --filter @pivot-ui/react panda && panda codegen",
    "storybook": "storybook dev -p 6007",
    "prestorybook": "pnpm --filter @pivot-ui/react panda && panda codegen",
    "build-storybook": "storybook build",
    "prebuild-storybook": "pnpm --filter @pivot-ui/react panda && panda codegen",
    "panda": "panda codegen",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.stories.json && tsc -p tsconfig.tooling.json",
    "pretypecheck": "pnpm --filter @pivot-ui/react panda && panda codegen",
    "clean": "rimraf dist types es lib .cache storybook-static styled-system node_modules/.cache node_modules/.vite node_modules/.vite-temp"
  },
  "keywords": [
    "ui",
    "editor",
    "tool",
    "react",
    "3d",
    "inspector"
  ],
  "author": {
    "name": "Mrkou47"
  },
  "license": "MIT",
  "devDependencies": {
    "@pandacss/dev": "2.2.0",
    "@storybook/addon-docs": "^10.6.3",
    "@storybook/addon-links": "^10.6.3",
    "@storybook/react": "^10.6.3",
    "@storybook/react-vite": "^10.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "^10.6.3"
  },
  "dependencies": {
    "@pivot-ui/react": "workspace:*",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-hover-card": "^1.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-menubar": "^1.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@radix-ui/react-use-controllable-state": "^1.3.0",
    "@radix-ui/react-visually-hidden": "^1.2.13",
    "@tabler/icons-react": "^3.49.0",
    "colord": "^2.10.0",
    "react-colorful": "^5.8.1",
    "react-hot-toast": "^2.6.1"
  },
  "peerDependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
